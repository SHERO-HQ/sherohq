# Server Configuration
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=your_jwt_secret_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database

# URLs
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:5000

# ─── Email ───────────────────────────────────────────────────────────────────
# Option A: SMTP (Gmail, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# SMTP_ALLOW_SELF_SIGNED=true   # Uncomment if using self-signed TLS certs

# Option B: Resend (takes priority over SMTP if RESEND_API_KEY is set)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=noreply@yourdomain.com   # Must be a verified domain in Resend

# ─── SMS — Hubtel ─────────────────────────────────────────────────────────────
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_SENDER_ID=SHERO                    # Display name shown on SMS (default: SHERO)

# ─── Payments — Hubtel ────────────────────────────────────────────────────────
HUBTEL_MERCHANT_ACCOUNT_NUMBER=your_merchant_account_number
HUBTEL_WEBHOOK_SECRET=your_hubtel_webhook_secret

# ─── WhatsApp — Meta Business Cloud API ──────────────────────────────────────
# Get from: Meta for Developers → Apps → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ─── Newsletter Scheduler ─────────────────────────────────────────────────────
NEWSLETTER_SCHEDULER_ENABLED=true         # Set to false to disable background scheduler
NEWSLETTER_SCHEDULER_INTERVAL_MS=60000   # How often to check for due campaigns (ms)
NEWSLETTER_MAX_CAMPAIGNS_PER_TICK=3      # Max campaigns dispatched per interval

# ─── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ─── Seeding ──────────────────────────────────────────────────────────────────
SKIP_SEEDING=false

# ─── Trustpilot Integration ───────────────────────────────────────────────────
TRUSTPILOT_API_KEY=your_trustpilot_api_key_here
TRUSTPILOT_BUSINESS_UNIT_ID=your_business_unit_id_here
TRUSTPILOT_API_BASE=https://api.trustpilot.com
