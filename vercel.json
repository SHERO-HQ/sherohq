{
  "framework": "nextjs",
  "buildCommand": "corepack prepare yarn@4.12.0 --activate && yarn build",
  "installCommand": "corepack prepare yarn@4.12.0 --activate && yarn install",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/og/:id",
      "destination": "/api/og/:id"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}