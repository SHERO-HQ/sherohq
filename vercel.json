{
  "framework": "nextjs",
  "buildCommand": "corepack enable && yarn build",
  "installCommand": "corepack enable && yarn install",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/og/:id",
      "destination": "/api/og/:id"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "* * * * *"
    }
  ]
}
