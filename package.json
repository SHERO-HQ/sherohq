    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.71.1",
    "react-is": "^19.2.3",
    "react-markdown": "^10.1.0",
