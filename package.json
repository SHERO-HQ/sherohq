{
  "name": "sherotech",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "server": "cd server && yarn dev",
    "dev:all": "concurrently \"yarn dev\" \"yarn server\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.js",
    "flush-db": "cd server && yarn flush-db",
    "flush": "yarn flush-db",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run"
  },
  "dependencies": {
