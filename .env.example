# ─── Frontend (Next.js) ────────────────────────────────────────────────────────
# Public URL of the deployed site (used for OG metadata)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Base URL of the Express API (no trailing slash)
# In production this should point to your hosted backend
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ─── Backend (Express — server/.env) ───────────────────────────────────────────
# PostgreSQL connection string (Supabase or self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Supabase project URL & service role key (for file uploads)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# Upstash Redis (for distributed rate limiting)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# JWT secret for admin/user sessions (min 32 chars)
JWT_SECRET=replace-with-a-long-random-secret

# Paystack secret key (webhook + initialize)
# Route supports either PAYSTACK_SECRET or PAYSTACK_SECRET_KEY
PAYSTACK_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxx
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Hubtel Online Checkout (Mobile Money / Card payments)
# Get credentials from your Hubtel Merchant Dashboard
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT_NUMBER=your_merchant_account_number
# Optional: override the Hubtel API base URL (defaults to https://payproxyapi.hubtel.com)
# HUBTEL_API_BASE_URL=https://payproxyapi.hubtel.com

# CORS — comma-separated allowed origins
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# SMTP settings for transactional email (optional)
# Set SMTP_ALLOW_SELF_SIGNED=true only for SMTP providers with self-signed certs
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="SHERO TECHNOLOGIES <newsletter@your-domain.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-smtp-password
# SMTP_ALLOW_SELF_SIGNED=false

# WhatsApp Cloud API (optional, required for WhatsApp campaigns)
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=1234567890

# Twilio SMS (optional, required for SMS campaigns)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin notifications
# ADMIN_NOTIFICATION_EMAIL=admin@sherohq.com
# ADMIN_NOTIFICATION_PHONE=+233548711582

# Node environment
NODE_ENV=production
PORT=5000

# Trustpilot Integration (Syncs reviews to database)
# Get from Trustpilot Business portal
TRUSTPILOT_API_KEY=your_trustpilot_api_key_here
TRUSTPILOT_BUSINESS_UNIT_ID=your_business_unit_id_here
TRUSTPILOT_API_BASE=https://api.trustpilot.com
