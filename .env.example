# ─── Frontend (Next.js) ────────────────────────────────────────────────────────
# Public URL of the deployed site (used for OG metadata)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Base URL of the Express API (no trailing slash)
# In production this should point to your hosted backend
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ─── Backend (Express — server/.env) ───────────────────────────────────────────
# PostgreSQL connection string (Supabase or self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Supabase project URL & service role key (for file uploads)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# JWT secret for admin/user sessions (min 32 chars)
JWT_SECRET=replace-with-a-long-random-secret

# Paystack secret key
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# CORS — comma-separated allowed origins
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# SMTP settings for transactional email (optional)
# Set SMTP_ALLOW_SELF_SIGNED=true only for SMTP providers with self-signed certs
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-smtp-password
# SMTP_ALLOW_SELF_SIGNED=false

# Admin notifications
# ADMIN_NOTIFICATION_EMAIL=admin@sherohq.com
# ADMIN_NOTIFICATION_PHONE=+233548711582

# Node environment
NODE_ENV=production
PORT=5000
