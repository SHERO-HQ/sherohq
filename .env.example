# Copy to .env.local for development. Never commit real values.

# Database. Locally: `docker compose up -d`, then `yarn db:migrate`.
DATABASE_URL=postgres://shero:shero@localhost:5432/shero

# Analytics (optional). Without these, no cookie notice is shown and nothing is tracked.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=


# Listing photos in production: Supabase Storage (a public bucket). Without
# these, photos are kept in .data/uploads, and only against a local database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=listing-photos
