# Copy to .env.local for development. Never commit real values.

# Database. Locally: `docker compose up -d`, then `yarn db:migrate`.
DATABASE_URL=postgres://shero:shero@localhost:5432/shero

# Analytics (optional). Without these, no cookie notice is shown and nothing is tracked.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=


# Listing photos in production: Supabase Storage (a public bucket). Without
# these, photos are kept in .data/uploads, and only against a local database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=listing-photos

# Emails to SHERO about new orders, consultation requests and waitlist signups
# (Resend, https://resend.com, with sherohq.com verified). Without a key nothing
# is sent; in development the email is printed in the terminal instead.
RESEND_API_KEY=
NOTIFY_FROM=SHERO <notifications@sherohq.com>

# The daily retention job (/api/cron/retention, scheduled in vercel.json) only
# runs with this set; Vercel sends it with each cron call. Any long random string.
CRON_SECRET=

# The shop's own site. Set in production only: "https://shop.sherohq.com".
# Unset locally and on previews, where this app serves the shop at /shop.
NEXT_PUBLIC_SHOP_URL=
