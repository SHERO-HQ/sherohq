# ─── Backend (Express — server/.env) ───────────────────────────────────────────
# PostgreSQL connection string (Supabase or self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Supabase project URL & service role key (for file uploads)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# JWT secret for admin/user sessions (min 32 chars)
JWT_SECRET=replace-with-a-long-random-secret

# Paystack secret key
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# CORS — comma-separated allowed origins
CORS_ORIGINS=https://sherohq.com,https://www.sherohq.com

# Node environment
NODE_ENV=production
PORT=5000
